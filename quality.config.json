{
  "version": 1,
  "checks": [
    {
      "id": "format",
      "script": "format:check",
      "stage": "edit",
      "patterns": ["."]
    },
    {
      "id": "source-size",
      "script": "check:source-size",
      "stage": "edit",
      "patterns": [
        "^src/.*\\.(?:ts|tsx|css)$",
        "^source-size\\.config\\.json$",
        "^scripts/quality/source-size"
      ]
    },
    {
      "id": "lint",
      "script": "lint",
      "stage": "edit",
      "patterns": [
        "^src/.*\\.[jt]sx?$",
        "^eslint\\.",
        "^tests/browser/",
        "^playwright\\.config\\."
      ]
    },
    {
      "id": "css",
      "script": "lint:css",
      "stage": "edit",
      "patterns": ["\\.css$", "^\\.stylelintrc"]
    },
    {
      "id": "types",
      "script": "typecheck",
      "stage": "checkpoint",
      "patterns": [
        "^src/.*\\.[jt]sx?$",
        "(^|/)tsconfig[^/]*\\.json$",
        "^next\\.config\\.",
        "^tests/browser/",
        "^playwright\\.config\\."
      ]
    },
    {
      "id": "harness",
      "script": "test:quality",
      "stage": "checkpoint",
      "patterns": [
        "^scripts/quality/",
        "^quality\\.config\\.json$",
        "^\\.github/workflows/",
        "^source-size\\.config\\.json$",
        "^src/app/_lib/use-step-navigation\\.ts$"
      ]
    },
    {
      "id": "build-and-og",
      "script": "check:build",
      "stage": "handoff",
      "patterns": [
        "^(src|public)/",
        "^next\\.config\\.",
        "^postcss\\.config\\.",
        "^scripts/check-og\\.mjs$"
      ]
    },
    {
      "id": "browser",
      "script": "test:browser",
      "stage": "handoff",
      "patterns": [
        "^scripts/quality/render-workshop-fixtures\\.cjs$",
        "^(src|public|tests/browser)/",
        "^playwright\\.config\\.",
        "^next\\.config\\.",
        "^postcss\\.config\\."
      ]
    }
  ]
}
